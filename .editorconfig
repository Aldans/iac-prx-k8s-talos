# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false  # trailing two-spaces = hard line break

[*.{tf,tftpl,tfvars,hcl}]
indent_size = 2

[Makefile]
indent_style = tab

[Justfile]
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2
