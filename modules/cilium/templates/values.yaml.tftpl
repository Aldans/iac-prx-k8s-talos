# Cilium values for Talos.
# Rendered through templatefile() in modules/cilium/main.tf — variables:
#   $${cluster_name}                    — Cilium cluster name (= var.cluster_name)
#   $${k8s_service_host}                — FQDN or localhost (KubePrism for kubeProxyReplacement)
#   $${k8s_service_port}                — 7445 for Talos (KubePrism)
#   $${pod_cidr}                        — IPv4 CIDR for native routing (= var.pod_cidr)
#   $${devices}                         — Cilium network interfaces (= var.cilium_devices)
#   $${ingress_enabled}                 — bool, when true Cilium serves `kind: Ingress`
#   $${ingress_default}                 — bool, when true the Cilium IngressClass is the cluster default
#   $${ingress_loadbalancer_mode}       — "shared" | "dedicated"
#   $${l2_announcements_enabled}        — bool, must be true when using CiliumL2AnnouncementPolicy
#   $${l2_announcements_lease_duration} — Go duration; node lease lifetime per announced IP
#   $${k8s_client_qps}                  — kube API client rate limit (bumped when L2 announcements on)
#   $${k8s_client_burst}                — kube API client burst

cluster:
  name: ${cluster_name}

# Talos KubePrism: a local TCP load-balancer at 127.0.0.1:7445 on every node, balancing
# towards all CP API servers. Cilium goes through it instead of the kubeconfig server
# so it does not depend on whether the first CP is alive.
kubeProxyReplacement: true
k8sServiceHost: ${k8s_service_host}
k8sServicePort: ${k8s_service_port}

ipam:
  mode: kubernetes

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true

operator:
  replicas: 1

hostServices:
  enabled: false

nodePort:
  enabled: true

externalIPs:
  enabled: true

hostPort:
  enabled: true

image:
  pullPolicy: IfNotPresent

routingMode: native
autoDirectNodeRoutes: true
ipv4NativeRoutingCIDR: ${pod_cidr}

devices: ${devices}

%{ if ingress_enabled ~}
# ----- Built-in Ingress controller (Envoy) ----------------------------------
# `kind: Ingress` resources are served directly by Cilium. cert-manager works
# with `ingressClassName: cilium`. The created LoadBalancer service picks up
# its external IP from a CiliumLoadBalancerIPPool (see infrastructure/
# controllers/cilium-lb in the Flux repo).
ingressController:
  enabled: true
  default: ${ingress_default}
  loadbalancerMode: ${ingress_loadbalancer_mode}
  service:
    type: LoadBalancer
%{ endif ~}

%{ if l2_announcements_enabled ~}
# ----- L2 announcements (ARP) for LoadBalancer IPs --------------------------
# Required for IPs allocated by CiliumLoadBalancerIPPool to be reachable on
# the LAN. Without this the LB service has an EXTERNAL-IP but no node ARP-
# announces it → the IP is unrouted. CiliumL2AnnouncementPolicy in the Flux
# repo (infrastructure/controllers/cilium-lb/) scopes which services and
# nodes participate.
l2announcements:
  enabled: true
  leaseDuration: ${l2_announcements_lease_duration}

# Lease polling adds API server pressure. Bump kube client rate limits.
k8sClientRateLimit:
  qps: ${k8s_client_qps}
  burst: ${k8s_client_burst}
%{ endif ~}
