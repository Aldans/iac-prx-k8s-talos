###############################################################################
# Talos / Kubernetes (optional)
###############################################################################
# talos_version       = "v1.13.0"
# talos_schematic_id  = "aeec243e3a4c2a14f9ba74b1a8c7662f03eea658a7ea5f1c26fdd491280c88f8"
# kubernetes_version  = "1.34.0"
# cilium_version      = "1.17.2"
# pod_cidr            = "10.244.0.0/16"
# cilium_devices      = "eth0"

# Cilium feature toggles (mutually exclusive: keep ingress OR gateway_api, not both).
# cilium_ingress_enabled          = false  # classic `kind: Ingress` controller (default: off)
# cilium_gateway_api_enabled      = true   # native `kind: Gateway` / HTTPRoute  (default: on)
# cilium_l2_announcements_enabled = true   # L2 LB IP announcements on LAN       (default: on)

###############################################################################
# Cloudflare (public tunnel)
###############################################################################
# Public ingress for in-cluster apps via Cloudflare Tunnel — no public IP / no
# port-forwarding needed on the home router. See modules/cloudflare-tunnel/README.md.
#
# API token scopes:
#   - Account › Cloudflare Tunnel › Edit
#   - Zone › DNS › Edit  (limited to the public domain)
#   - Zone › Zone › Read (limited to the public domain)
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Custom Token.

cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "00000000000000000000000000000000"   # Cloudflare dashboard → right sidebar → "Account ID"
public_domain         = "example.com"                         # Cloudflare-managed zone that already exists in the account
# public_subdomain    = ""                                    # default (empty) — apps live at <app>.<public_domain> (covered by Universal SSL on Free plan).
                                                              # Set to e.g. "apps" only if you have Cloudflare ACM / Total TLS / Advanced Certificate (~$10/mo).

# Email allow-list for Cloudflare Access (Zero Trust SSO) on admin apps.
# Required when any cloudflare-public-app module has access.enabled = true.
admin_emails = ["you@example.com"]

###############################################################################
# OCI Registry mirror (optional)
###############################################################################
# Point Talos containerd at a pull-through registry mirror. Vendor-neutral —
# works with Garage+Zot, Harbor, Hetzner CR, AWS ECR, etc. Leave commented to
# fetch images directly from upstream.
#
# ENABLE
#   1. Uncomment the block below.
#   2. terraform apply  — Talos rolls the new machineconfig out to every node.
#      No reboot required for activation; containerd hot-reloads hosts.toml.
#
# DISABLE (rollback to direct upstream pulls)
#   1. Re-comment the block below.
#   2. terraform apply  — the patch is removed from the machineconfig, but
#      Talos does NOT delete the on-disk /etc/cri/conf.d/hosts/<host>/hosts.toml
#      files left behind by the previous machine.files patch.
#   3. Reboot every node, one at a time, to wipe stale hosts.toml and
#      regenerate them from the (now empty) registries config:
#
#        for ip in $(terraform output -json control_plane_initial_ips worker_initial_ips \
#                    | jq -r '.[][]'); do
#          talosctl --talosconfig=./talosconfig -n "$ip" reboot
#          # wait for the node to come back Ready before moving on
#        done
#
#   For a quick "off" without re-applying anything (e.g. mirror outage debug),
#   stop the registry service: `ssh admin@<storage-vm> sudo systemctl stop zot`.
#   containerd will fall back to upstream after a short retry delay.
#
# registry_mirror = {
#   endpoint             = "https://lab-storage.lab.lan:5000"
#   insecure_skip_verify = true        # for self-signed certs
#   # ca_cert            = file("./registry-ca.pem")  # alternative: trust the CA
# }
