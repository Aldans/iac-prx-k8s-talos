# Copy this file to credentials.auto.tfvars and fill in your values.
# credentials.auto.tfvars is in .gitignore and will be picked up by Terraform automatically.

###############################################################################
# Proxmox API
###############################################################################
prx = {
  endpoint  = "https://your-proxmox-host:8006/api2/json"
  username  = "root"
  password  = "your-password"
  api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"
}

# Proxmox cluster node name (default "mf")
# prx_node             = "mf"
# prx_datastore_image  = "local"      # storage for the downloaded Talos image
# prx_datastore_vm     = "local-zfs"  # storage for VM disks
# prx_network_bridge   = "vmbr1"      # bridge with DHCP + dnsmasq

###############################################################################
# DNS
###############################################################################
# Domain in which dnsmasq on the Proxmox host resolves VM hostnames.
# Must match domain= in /etc/dnsmasq.conf on Proxmox.
# dns_domain = "lab.lan"

###############################################################################
# GitHub (for Flux GitOps)
###############################################################################
# Personal Access Token. Required scopes:
#   - repo (create + push to a private repo)
#   - admin:public_key (deploy key)
# Generate at: https://github.com/settings/tokens (classic) or
#              https://github.com/settings/personal-access-tokens/new (fine-grained)
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Repository owner (your username or organization).
github_owner = "your-github-user"

# Repository name to be created by Terraform. If it already exists, TF apply will fail;
# either delete it on GitHub or run: terraform import github_repository.flux <name>.
github_repo = "flux-mf"

# flux_branch = "main"
# flux_path   = "clusters/tl01"   # literal string; tfvars do NOT support interpolation.
                                  # Leave null (default) and TF will substitute "clusters/${var.cluster_name}".

###############################################################################
