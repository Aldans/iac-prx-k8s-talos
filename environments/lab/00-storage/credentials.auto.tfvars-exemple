# Copy to credentials.auto.tfvars and fill in.
# credentials.auto.tfvars is in .gitignore — Terraform picks it up automatically.

###############################################################################
# Proxmox API (same shape as kubernetes_iac/)
###############################################################################
prx = {
  endpoint  = "https://your-proxmox-host:8006/api2/json"
  username  = "root"
  password  = "your-password"
  api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"
}

# Proxmox node where the storage VM will live. Default "mf".
# prx_node             = "mf"
# prx_datastore_image  = "local"
# prx_datastore_vm     = "local-zfs"
# prx_network_bridge   = "vmbr1"

###############################################################################
# DNS (must match kubernetes_iac/)
###############################################################################
# dns_domain = "lab.lan"
# hostname   = "lab-storage"

###############################################################################
# SSH
###############################################################################
# Public key authorised for the 'admin' user on the storage VM.
# Used for troubleshooting only — Terraform does not SSH in.
admin_ssh_pubkey = "ssh-ed25519 AAAA..."

