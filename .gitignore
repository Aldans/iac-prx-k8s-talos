# Local .terraform directories
**/.terraform/*

# Any tfvars files — may contain secrets.
# Exception: -exemple/-example templates without real values.
*.tfvars
!*.tfvars-exemple
!*.tfvars-example
!*.tfvars.example

# Terraform override files
*.tfoverride

# Terraform plan files (may contain secrets in binary form)
*.tfplan

# Crash logs
crash.log
crash.*.log

# Environment-specific
.envrc

# CLI configuration
.terraformrc
terraform.rc

# State and local lock files
terraform.tfstate*
.terraform.tfstate.d/*
.terraform/tfstate.lock.hcl
.terraform.tfstate.lock.info

# Provider lock files inside modules — only stack roots should pin versions.
# Created when pre-commit's terraform_validate hook walks into module dirs.
modules/*/.terraform.lock.hcl

# Backend partial-config files. Contain S3 credentials for the Garage/MinIO
# state bucket. Use backend.s3.hcl.example as a template.
backend.s3.hcl
backend.s3.hcl.bak

# IDE
**/.vscode/*
**/.idea/*

# Kubernetes / Talos configs (generated by local_file resources)
kubeconfig
talosconfig

# Claude Code local settings (may carry project-specific permissions)
.claude/settings.local.json

# Claude Code transient state — slash-command outputs (last-audit.md, last-fix.md,
# last-test.md). Regenerated on every /audit, /fix, /test, /cycle run. Excluded
# because audit reports occasionally embed partial leaked-secret prefixes that
# the auditor flagged.
.claude/state/*
!.claude/state/README.md

# Long-term audit history is timestamp-keyed (.claude/audit-history/<ts>/...).
# We keep the directory marker but ignore the contents.
.claude/audit-history/*
!.claude/audit-history/.gitkeep

# Serena (MCP code-indexer) local project workspace — cache, memories,
# per-machine config. Local tooling, not part of the repo.
.serena/

# DEV directory with experimental manifests and old artefacts
/test/

# macOS
.DS_Store
**/.DS_Store
